appsettings.Local.json

# Rider / JetBrains
.idea/
*.DotSettings.user

# Logs
*.log
logs/

# Pacotes NuGet restaurados automaticamente
*.nupkg
.nuget/

# Publicação
publish/
out/

# Cobertura de testes
TestResults/
coverage/